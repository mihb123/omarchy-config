{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "mihb.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "birthYear": 1999,
          "lifeExpectancy": 80
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "workspaces"
        },
        {
          "id": "runcat"
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/ram-status",
          "id": "ram",
          "interval": 2,
          "onClick": "omarchy-launch-or-focus-tui btop",
          "tooltip": "Memory Usage\nleft — System Monitor (btop)",
          "type": "command"
        }
      ],
      "right": [
        {
          "id": "mihb.ime"
        },
        {
          "id": "notifications",
          "type": "qml"
        },
        {
          "id": "omarchy.tray",
          "hidden": [
            "Fcitx"
          ]
        },
        {
          "id": "quick-settings"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        },
        {
          "id": "shortcut-tooltips",
          "type": "qml"
        },
        {
          "id": "user.trackpad-gestures",
          "captureAction": "screenshot",
          "captureTrigger": "none",
          "clickMethod": "clickfinger",
          "enabled": true,
          "f2_down": "none",
          "f2_left": "none",
          "f2_pinchin": "none",
          "f2_pinchout": "none",
          "f2_right": "none",
          "f2_up": "none",
          "f3_down": "fit_active",
          "f3_left": "workspace",
          "f3_pinchin": "none",
          "f3_pinchout": "none",
          "f3_right": "workspace",
          "f3_up": "fit_all",
          "f4_down": "volume_down",
          "f4_left": "brightness_down",
          "f4_pinchin": "none",
          "f4_pinchout": "none",
          "f4_right": "brightness_up",
          "f4_up": "volume_up",
          "screenshotEditor": false,
          "selectedFingers": 2,
          "tapMap": "lrm"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 180
  },
  "plugins": [
    {
      "id": "mihb.menu"
    },
    {
      "id": "mihb.notifications"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.menu",
    "omarchy.notifications"
  ],
  "cloneSourceRestores": [
    "mihb.menu",
    "mihb.notifications"
  ]
}
