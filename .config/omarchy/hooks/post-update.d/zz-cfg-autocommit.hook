#!/bin/bash
# Sau mỗi `omarchy update`: lưu lại đúng những gì update đã đổi trong config,
# kể cả file MỚI do migration tạo ra. Xem lại bằng: cfg show HEAD
set -uo pipefail
command -v cfg >/dev/null || exit 0
cfg save "post-update: omarchy $(omarchy version 2>/dev/null || echo unknown)" \
  || echo "cfg: bỏ qua auto-commit (xem cảnh báo phía trên), chạy tay: cfg save"
