+    root.perf.marks.push(label + " @" + (Date.now() - root.perf.t0))
+    root.perf.marks.push("heightCalls=" + root.perf.heightCalls + " heightMs=" + root.perf.heightMs)
+    console.warn("[menu-perf] " + root.perf.marks.join(" | "))
+    root.perf.t0 = 0
+  }
