+  // ------------------------------------------------------- fast open channel
+  //
+  // `omarchy-shell shell summon omarchy.menu <payload>` has to spawn the `qs`
+  // client, and that Qt process costs ~90ms of dynamic linking before a
+  // single byte of payload moves — more than everything else on the SUPER+K
+  // path put together. A Unix socket lets a caller hand over the same payload
+  // with socat in ~2ms.
+  //
+  // The socket lives in XDG_RUNTIME_DIR (mode 0700), so it is reachable only
+  // by this user — the same trust boundary the qs ipc socket already has, and
+  // it carries the same payloads. Callers that cannot reach it fall back to
+  // qs ipc, which keeps working unchanged.
+  //
+  // Protocol: one line of JSON per connection, exactly the payload
+  // shell.summon() takes. Routing through shell.summon rather than open()
+  // keeps the host's open-panel bookkeeping identical on both paths.
+  SocketServer {
+    active: true
+    path: Quickshell.env("XDG_RUNTIME_DIR") + "/omarchy-menu-open.sock"
+
+    handler: Socket {
+      parser: SplitParser {
+        onRead: function(line) {
+          var payload = String(line || "").trim()
+          if (!payload) return
+          if (root.shell && typeof root.shell.summon === "function")
+            root.shell.summon("omarchy.menu", payload)
+          else
+            root.open(payload)
+        }
+      }
+    }
+  }
