      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/mihb/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5": {
      "effortLevel": "high"
    }
  },
  "awaySummaryEnabled": false,
  "theme": "dark",
  "inputNeededNotifEnabled": true
}
